# ===== BẮT BUỘC =====
# PostgreSQL (Neon). Chạy thử trên máy: npm run db:local rồi dùng dòng localhost bên dưới
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"

# Chuỗi ngẫu nhiên dài >= 32 ký tự để ký phiên đăng nhập (BẮT BUỘC khi chạy production)
SESSION_SECRET=""

# ===== CLOUDFLARE R2 (lưu ảnh minh chứng) =====
# Để trống khi chạy thử trên máy: ảnh sẽ lưu tạm vào thư mục .local-uploads/
# Trên Vercel BẮT BUỘC điền đủ 4 biến này
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ===== TẠO TÀI KHOẢN ADMIN ĐẦU TIÊN (npm run db:seed) =====
SEED_ADMIN_NAME="Quản trị viên"
# Để trống: hệ thống tự sinh PIN và in ra màn hình
SEED_ADMIN_PIN=""
